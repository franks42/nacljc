{:paths ["src" "test"]
 :tasks
 {:requires ([clojure.string :as str])

  test:bb   {:doc  "Run the vector tests on babashka"
             :task (do (require 'clojure.test 'nacljc.core-test 'nacljc.process-test)
                       (let [r (clojure.test/run-tests 'nacljc.core-test 'nacljc.process-test)]
                         ;; exit only on failure: exiting 0 would end test:all here
                         (when (pos? (+ (:fail r) (:error r))) (System/exit 1))))}

  test:jvm  {:doc  "Run the vector tests on JVM Clojure (JDK 25+)"
             :task (shell "clojure" "-M:test" "-e"
                          (str "(require 'clojure.test 'nacljc.core-test 'nacljc.process-test)"
                               "(let [r (clojure.test/run-tests 'nacljc.core-test 'nacljc.process-test)]"
                               "  (System/exit (if (pos? (+ (:fail r) (:error r))) 1 0)))"))}

  test:nbb  {:doc  "Run the vector tests on nbb (Node 26+ node:ffi)"
             :task (shell "nbb" "-cp" "src:test" "-e"
                          "(require 'cljs.test 'nacljc.core-test 'nacljc.process-test) (cljs.test/run-tests 'nacljc.core-test 'nacljc.process-test)")}

  test:loading {:doc  "Library loading in fresh processes on bb, nbb and the JVM: defaults, NACLJC_LIBSODIUM, -Dnacljc.libsodium, missing and wrong libraries"
                :task (shell "bb" "-cp" "test" "-m" "loading.run")}

  test:secrets {:doc  "Secret memory faults when read outside an access window or after destroy (child processes on bb, the JVM and nbb)"
                :task (shell "bb" "-cp" "test" "-m" "secrets.run")}

  test:process {:doc  "Opt-in process hardening (nacljc.process) in fresh child processes on bb, the JVM and nbb"
                :task (shell "bb" "-cp" "test" "-m" "process.run")}

  test:wasm {:doc  "Check libsodium.js (WASM) against the same vectors (needs npm install in test/wasm)"
             :task (shell {:dir "test/wasm"} "nbb" "check.cljs")}

  test:browser {:doc  "Scittle + libsodium.js in headless Chromium (needs npm install in test/browser; network). Optional arg: a libsodium.js browser build URL or path"
                :task (apply shell {:dir "test/browser"} "node" "run.mjs" *command-line-args*)}

  test:jca  {:doc  "Cross-check against signet's JCA backend (needs ../signet)"
             :task (do (shell "bb" "-cp" "src:test:../signet/src" "-m" "nacljc.jca-crosscheck")
                       (shell "clojure" "-Sdeps"
                              "{:aliases {:signet {:extra-paths [\"../signet/src\"]}}}"
                              "-M:test:signet" "-m" "nacljc.jca-crosscheck"))}

  ;; signet's own test suite, run in ../signet with its :sodium backend,
  ;; with nacljc replaced by this checkout (:override-deps beats the alias's
  ;; Clojars version). This is what signet's users run. (Until 0.3.2 a shim
  ;; stood in for signet's backend; signet has had its own since 0.7.0.)
  test:signet-jvm {:doc  "signet's suite on the JVM, libsodium backend, on this nacljc. Needs ../signet"
                   :task (shell {:dir "../signet"} "clojure" "-Sdeps"
                                "{:aliases {:local-nacljc {:override-deps {com.github.franks42/nacljc {:local/root \"../nacljc\"}}}}}"
                                "-M:test:sodium:local-nacljc")}

  test:signet-parity {:doc  "signet's JCA-vs-libsodium parity checks, on this nacljc. Needs ../signet"
                      :task (shell {:dir "../signet"} "clojure" "-Sdeps"
                                   (str "{:aliases {:t {:extra-paths [\"test\"]}"
                                        " :local-nacljc {:override-deps {com.github.franks42/nacljc {:local/root \"../nacljc\"}}}}}")
                                   "-M:t:sodium:local-nacljc" "-m" "signet.backend-parity" "sodium")}

  test:signet-bb  {:doc  "signet's suite on babashka, libsodium backend, on this nacljc. Needs ../signet"
                   :task (shell {:dir "../signet" :extra-env {"SIGNET_BACKEND" "sodium"}}
                                "bb" "-e" (str "(babashka.deps/add-deps '{:deps {com.github.franks42/nacljc {:local/root \"../nacljc\"}}})"
                                               "(require 'signet.suite) (signet.suite/-main \"sodium\")"))}

  test:signet {:doc  "signet's suite on this nacljc: JVM, parity, babashka. Needs ../signet"
               :task (do (run 'test:signet-jvm) (run 'test:signet-parity) (run 'test:signet-bb))}

  test:all  {:doc  "Every runtime (bb, JVM, nbb, WASM on Node, Scittle in Chromium), library loading, lint and format"
             :task (do (run 'test:bb) (run 'test:jvm) (run 'test:nbb) (run 'test:loading) (run 'test:secrets) (run 'test:process)
                       (run 'test:wasm) (run 'test:browser) (run 'lint) (run 'fmt))}

  test:jar  {:doc  "Install the jar, then run the suite against it from a scratch project (no src/) on the JVM, bb and nbb. Refuses a version already on Clojars."
             :task (do (run 'check-not-released)
                       (shell "clojure" "-P") ; fresh machines: tools.build cannot fetch deps itself
                       (shell "clojure" "-T:build" "install")
                       (shell "bb" "-cp" "test" "-m" "consumer.check" "local"))}

  test:clojars {:doc  "Run the suite against a release fetched from Clojars (empty local repo), on the JVM, bb and nbb. Arg: version"
                :task (apply shell "bb" "-cp" "test" "-m" "consumer.check" "clojars" *command-line-args*)}

  check-not-released
  {:doc  "Fail if build.clj's version is already published on Clojars: installing it locally would shadow the real jar in ~/.m2"
   :task (let [ver (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)") (slurp "build.clj")))
               url (str "https://repo.clojars.org/com/github/franks42/nacljc/" ver "/nacljc-" ver ".pom")
               published? (zero? (:exit (shell {:continue true :out :string :err :string} "curl" "-sfI" url)))]
           ;; Refuse to install a released version: the local build would shadow the
           ;; published jar in ~/.m2 (it happened once, 2026-09-23, right after a release).
           (when published?
             (println "ERROR: nacljc" ver "is already on Clojars; bump build.clj to the next -SNAPSHOT before installing")
             (System/exit 1)))}

  release-check {:doc  "Refuse to release unless build.clj's version is a plain X.Y.Z and CHANGELOG.md has a section for it"
                 :task (let [ver (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)") (slurp "build.clj")))
                             fail (fn [& msg] (apply println "ERROR:" msg) (System/exit 1))]
                         (cond
                           (nil? ver) (fail "cannot parse the version from build.clj")
                           (not (re-matches (re-pattern "\\d+\\.\\d+\\.\\d+") ver))
                           (fail "version" (pr-str ver) "is not a stable X.Y.Z")
                           ;; a dated heading, "## X.Y.Z (YYYY-MM-DD)": "(unreleased)" is refused
                           (not (re-find (re-pattern (str "(?m)^## " (java.util.regex.Pattern/quote ver)
                                                          " \\(\\d{4}-\\d{2}-\\d{2}\\)"))
                                         (slurp "CHANGELOG.md")))
                           (fail (str "CHANGELOG.md has no dated \"## " ver " (YYYY-MM-DD)\" section"))
                           :else (println "release-check: version" ver "is releasable")))}

  install   {:doc  "Install the jar (build.clj's version) into ~/.m2 (re-run after changes)"
             :task (shell "clojure" "-T:build" "install")}

  lint      {:doc  "clj-kondo on every Clojure file"
             :task (shell "clj-kondo" "--lint" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  fmt       {:doc  "cljfmt check on every Clojure file"
             :task (shell "cljfmt" "check" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  fmt:fix   {:doc  "cljfmt fix on every Clojure file"
             :task (shell "cljfmt" "fix" "src" "test" "build.clj" "bb.edn" "deps.edn")}}}
